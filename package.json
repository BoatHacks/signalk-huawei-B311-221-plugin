{
  "name": "@boathacks/signalk-huawei-b311-221",
  "version": "0.1.1",
  "description": "Signal K plugin for the Huawei B311-221 LTE router: signal, connection, data plan and SMS",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BoatHacks/signalk-huawei-B311-221-plugin.git"
  },
  "homepage": "https://github.com/BoatHacks/signalk-huawei-B311-221-plugin#readme",
  "bugs": {
    "url": "https://github.com/BoatHacks/signalk-huawei-B311-221-plugin/issues"
  },
  "main": "dist/index.js",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist/",
    "public/",
    "docs/images/",
    "status-tiles-examples.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "format": "biome check --write src test scripts public",
    "lint": "biome check src test scripts public",
    "test": "node scripts/run-tests.mjs",
    "prepack": "npm run build"
  },
  "keywords": [
    "signalk-node-server-plugin",
    "signalk-category-hardware",
    "signalk-webapp",
    "huawei",
    "lte"
  ],
  "signalk": {
    "displayName": "Huawei B311-221 LTE",
    "appIcon": "./icon.png",
    "screenshots": [
      "./docs/images/webapp.png",
      "./docs/images/webapp-phone.png"
    ],
    "recommends": [
      "@meri-imperiumi/signalk-status-tiles",
      "@meri-imperiumi/signalk-internet"
    ]
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@signalk/server-api": "^2.30.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.8.0"
  },
  "dependencies": {
    "fast-xml-parser": "^5.11.2"
  }
}
